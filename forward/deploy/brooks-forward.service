[Unit]
Description=Brooks forward paper-trading daily collection
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=BROOKS_REPO=%h/brooks-price-action
# Adjust PATH to include your authenticated Claude CLI installation.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/brooks-price-action/forward/deploy/run-scheduled.sh
TimeoutStartSec=4h
UMask=0077
